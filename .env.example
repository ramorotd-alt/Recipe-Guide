# Copy this file to .env.local and fill in the two values.
# Supabase Dashboard → Project Settings → API Keys.
# Use the publishable key. Do not put the secret key in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Older projects may only show a legacy anon key. You can paste that value
# above, or set it with this name instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
